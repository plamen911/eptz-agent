{
  "name": "eptz-agent",
  "private": true,
  "description": "Forensic fire-expert report (ЕПТЗ) agent on the Claude Agent SDK",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "vendor:plugin": "bash scripts/vendor-plugin.sh",
    "case": "npm run case --workspace server --",
    "turn": "npm run turn --workspace server --",
    "check:plugin": "npm run check:plugin --workspace server",
    "serve": "npm run serve --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web"
  }
}
