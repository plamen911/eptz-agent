# Anthropic API key for this project only (console.anthropic.com → API keys).
# Set a monthly spend limit on the workspace as well.
ANTHROPIC_API_KEY=

# Personal key for the fire-service n8n endpoints (approved expertises, staff list, regulations).
# Without it the skill's scripts stop with NO_KEY and the agent works from the case materials only.
FIRE_SERVICE_KEY=

# Hard stop for one case, in USD (the SDK's estimate – keep headroom).
CASE_BUDGET_USD=3

# Models
READER_MODEL=claude-haiku-5-5
WRITER_MODEL=claude-sonnet-5-5
WRITER_FALLBACK_MODEL=claude-sonnet-5

# OS sandbox for the agent's commands: on (default) | off – off only for development behind an egress proxy.
SANDBOX=on

# Prompt cache of the agent: 1h (survives the expert's pauses) | 5m (cheaper to write, for a case written in one go)
PROMPT_CACHE_TTL=5m

# Web server (npm run serve)
HOST=127.0.0.1
PORT=8787
# Required on every /api request; required too when HOST is not localhost. 24+ characters:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_TOKEN=
